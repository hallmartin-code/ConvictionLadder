# Copy to .env for local dev, or set these as Railway service variables.

# Required. Your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended once deployed. Without it, anyone with the Railway URL
# can upload decks and spend your API budget.
APP_PASSWORD=choose-a-long-random-string
APP_USERNAME=ten

# Optional tuning.
MAX_CONCURRENT=2
JOB_TTL_SECONDS=3600
